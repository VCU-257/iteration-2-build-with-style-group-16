    </div>

  </div>
</div>

<script>
function getCart(){
  return JSON.parse(localStorage.getItem("cart")) || [];
}

function saveCart(cart){
  localStorage.setItem("cart", JSON.stringify(cart));
}

function changeQty(id, delta){
  const el = document.getElementById(id + "Qty");
  let val = parseInt(el.textContent);
  val = Math.max(0, val + delta);
  el.textContent = val;
}

function addToCart(id, name, price, qtyId){
  let qty = parseInt(document.getElementById(qtyId).textContent);

  if(qty < 1){
    alert("Please select at least 1 item");
    return;
  }

  let cart = getCart();
  let existing = cart.find(item => item.id === id);

  if(existing){
    existing.count += qty;
  } else {
    cart.push({
      id: id.toString(),   // match cart page
      name: name,
      price: price,
      count: qty
    });
  }

  saveCart(cart);
  updateCartCount();

  // reset to 1 (NOT 0)
  document.getElementById(qtyId).textContent = 1;
}



function updateCartCount(){
  const cart = getCart();
  let total = 0;

  cart.forEach(item => total += item.count);

  const badge = document.getElementById("cartCount");

  if(total === 0){
    badge.style.display = "none"; // 👈 hide it
  } else {
    badge.style.display = "block";
    badge.textContent = total;
  }
}

document.addEventListener("DOMContentLoaded", updateCartCount);
</script>

